# Automatia ABS — infra env (source-build stack: infra/docker-compose.yml).
# infra/install.sh (internal, builds from source) copies this file to .env.
# A customer install uses the packaged archive from /download instead — its
# template is the repo-root .env.example.

# --- General ---
ABS_ADMIN_EMAIL=admin@example.com
ABS_DOMAIN=abs.local
# "internal" = self-signed (dev), "acme" = Let's Encrypt (prod)
ABS_SSL_MODE=internal
ABS_ENV=dev

# --- License (filled on the installing side) ---
ABS_LICENSE_KEY=

# === VENDOR-ONLY below: never filled on a customer box ====================
# --- License signing keys (ours; only the public key ships in the image) ---
ABS_PRIVATE_KEY_PATH=/app/data/private.pem
ABS_PUBLIC_KEY_PATH=/app/data/public.pem

# --- Stripe (ours: the billing server, not a customer install) ---
ABS_STRIPE_SECRET_KEY=sk_test_...
ABS_STRIPE_WEBHOOK_SECRET=whsec_...

# === End vendor-only =====================================================

# --- SMTP (blank = emails are printed to the console) ---
ABS_SMTP_HOST=
ABS_SMTP_PORT=587
ABS_SMTP_USER=
ABS_SMTP_PASSWORD=
ABS_SMTP_FROM=noreply@automatiabcn.com

# --- DB ---
ABS_DATABASE_URL=sqlite:////app/data/abs.db

# --- MCP provider API keys (005) ---
# Real keys go in .env; .env.example is committed, .env never is.
ABS_ANTHROPIC_API_KEY=
ABS_GROQ_API_KEY=
ABS_CEREBRAS_API_KEY=
ABS_GEMINI_API_KEY=
ABS_CF_ACCOUNT_ID=
ABS_CF_API_TOKEN=
ABS_COHERE_API_KEY=
ABS_OLLAMA_URL=

# MVP: false (demo mode open); flip to true to require a licence (008).
ABS_MCP_REQUIRE_LICENSE=false

# --- Hooks (007) ---
ABS_HOOKS_ENABLED=true
ABS_HOOKS_MODE=middleware  # middleware | native | both
ABS_CACHE_DIR=/app/data/cache
ABS_ARTIFACTS_DIR=/app/data/artifacts

# Host port the editor talks to on a local install (loopback only).
# Change it if something else already uses 8000.
ABS_LOCAL_PORT=8000
