{
	# Customer-facing reverse proxy. The site address is sourced from the
	# customer's .env via $ABS_DOMAIN (e.g. abs.acme.com).
	#
	# It used to read $ABS_PUBLIC_HOSTNAME, a name nothing sets: not
	# .env.example, not the compose file — it survived only here and in compose
	# comments. An unset variable leaves the site block below without a key,
	# and a keyless block is how Caddy spells "global options", so it rejected
	# the entire config and crash-looped. Found 2026-08-03 by installing the
	# archive the way a customer would: every service healthy, front door dead,
	# installer printing "server is up". The names have to match .env.example.
	# Caddy auto-provisions a Let's Encrypt certificate via the HTTP-01
	# challenge as long as port 80 + 443 are reachable from the public
	# internet. Override with `tls internal` for pre-DNS smoke tests.
	admin off
	# email is required for ACME contact + revocation notices.
	email {$ABS_ADMIN_EMAIL:admin@example.com}
}

{$ABS_DOMAIN} {
	# Pre-DNS smoke toggle.
	# UNCOMMENT the next line to force self-signed certs (lets you hit
	# https://abs.local with `curl -k` before DNS points at the host).
	# Leave commented in production so Caddy's default ACME HTTP-01 flow
	# (driven by the global `email` directive) issues real Let's Encrypt
	# certs once port 80 + 443 are reachable.
	# tls internal

	# Security hardening headers (defense-in-depth). CSP is intentionally
	# omitted: a strict policy breaks the Next.js panel's inline/runtime
	# chunks, and these headers already cover clickjacking, MIME-sniffing,
	# referrer leakage + force HTTPS. `-Server` strips the software banner.
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# route split. Backend exposes API + setup wizard + auth + MCP
	# transport on FastAPI (port 8000). Everything else (marketing pages
	# + Next.js admin panels under /admin/*) goes to the landing image
	# (Next.js standalone on port 3000).
	# `/me/*` added so KVKK / GDPR
	# self-service endpoints (data-export, delete-request, delete-confirm,
	# consents, audit-log) reach FastAPI instead of falling through to
	# the Next.js 404 page.
	@backend path /v1/* /auth/* /me/* /setup* /healthz /mcp* /static/* /panel /panel/* /api/inngest /api/inngest/*
	handle @backend {
		reverse_proxy backend:8000
	}

	# Default: marketing + Next.js admin under /admin/*.
	handle {
		reverse_proxy landing:3000
	}
}
